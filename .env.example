# Neon: select "Java" in the Connect dialog and copy the pooled JDBC values.
DB_URL=jdbc:postgresql://YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DB_USERNAME=YOUR_NEON_ROLE
DB_PASSWORD=YOUR_NEON_PASSWORD
DB_POOL_SIZE=5
DB_MIN_IDLE=0

# The exact Vercel production origin; do not add a trailing slash.
CORS_ORIGINS=https://YOUR-FRONTEND.vercel.app

# Generate with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG
DDL_AUTO=update

# Used only to create the first administrator and sample doctors on an empty DB.
BOOTSTRAP_DATA=true
BOOTSTRAP_ADMIN_USERNAME=admin@medora.in
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_INITIAL_PASSWORD
